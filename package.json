{
  "name": "pixel-mirror",
  "version": "2.1.0",
  "description": "Pixel Mirror helps developers achieve pixel-perfect UIs by easily overlaying design mockups.",
  "license": "Apache-2.0",
  "author": "Peiwen Lu",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint . && stylelint './src/**/*.svelte' && prettier --check .",
    "lint:fix": "eslint --fix . && stylelint --fix './src/**/*.svelte' && prettier --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm run build",
    "prepare": "husky"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./plugins/vite.d.ts",
      "default": "./plugins/vite.js"
    },
    "./astro": {
      "types": "./plugins/astro.d.ts",
      "default": "./plugins/astro.js"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "cssnano": "^9.8.0",
    "cssnano-preset-advanced": "^9.7.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "idb": "^8.0.4",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "sass": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-prettier": "^5.0.3",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "lint-staged": {
    "*.{js,ts,svelte}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,html}": [
      "prettier --write"
    ]
  },
  "files": [
    "index.d.ts",
    "dist",
    "plugins",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "vite",
    "design",
    "pixel-perfect",
    "ui-overlay",
    "mockup",
    "frontend-tool",
    "svelte",
    "developer-tools"
  ],
  "homepage": "https://github.com/p233-studio/pixel-mirror#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p233-studio/pixel-mirror.git"
  },
  "bugs": {
    "url": "https://github.com/p233-studio/pixel-mirror/issues"
  },
  "types": "./index.d.ts"
}
